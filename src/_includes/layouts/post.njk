---
layout: "base"
---

<div class="flex flex-col container max-w-3xl mx-auto h-full">
  <header class="mb-8">
    <p class="mt-0">
      <a class="font-bold" href="/">返回</a>
    </p>
  </header>

  <div class="pb-5 mb-5 border-b  border-gray-100">
    <h1 class="text-5xl">{{ title }}</h1>
    <p class="text-gray-400">
      <time datetime="{{ created | dateReadable }}">发布于{{ created | dateReadable }}</time>

      {% if updated %}
       · <time datetime="{{ updated | dateReadable }}">更新于{{ updated | dateReadable }}</time>
      {% endif %}
    </p>
  </div>

  <article class="prose lg:prose-lg">
    {{ content | safe }}
  </article>

  {% include "components/footer.njk" %}
</div>
